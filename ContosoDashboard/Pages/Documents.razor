@page "/documents"
@attribute [Authorize]
@using System.Security.Claims
@inject IDocumentService DocumentService
@inject IProjectService ProjectService
@inject IUserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Documents - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Documents</h1>
            <p class="text-muted mb-0">Upload, find, and securely share your work files.</p>
        </div>
        <button class="btn btn-primary" @onclick="ToggleUpload"> <i class="bi bi-upload"></i> Upload document</button>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")" role="alert">@message</div>
    }

    @if (showUpload)
    {
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">Upload document</h5></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label">Title</label><input class="form-control" @bind="title" /></div>
                    <div class="col-md-6"><label class="form-label">Category</label><select class="form-select" @bind="category"><option value="">Choose category</option>@foreach (var item in DocumentValidation.Categories) { <option value="@item">@item</option> }</select></div>
                    <div class="col-md-6"><label class="form-label">Project</label><select class="form-select" @bind="projectId" disabled="@taskId.HasValue"><option value="">Personal file</option>@foreach (var project in projects) { <option value="@project.ProjectId">@project.Name</option> }</select>@if (taskId.HasValue) { <small class="text-muted">The task supplies its project.</small> }</div>
                    <div class="col-md-6"><label class="form-label">Task</label><select class="form-select" @bind="taskId" @bind:after="TaskChanged"><option value="">No task</option>@foreach (var task in AvailableTasks) { <option value="@task.TaskId">@task.Title</option> }</select></div>
                    <div class="col-md-6"><label class="form-label">Tags</label><input class="form-control" @bind="tags" placeholder="budget, planning" /></div>
                    <div class="col-12"><label class="form-label">Description</label><textarea class="form-control" @bind="description"></textarea></div>
                    <div class="col-12"><label class="form-label">File</label><InputFile @key="inputKey" OnChange="SelectFile" /></div>
                </div>
                @if (selectedFile != null) { <p class="small text-muted mt-3 mb-0">@selectedFile.Name (@FormatSize(selectedFile.Size))</p> }
                @if (isUploading) { <div class="progress mt-3"><div class="progress-bar progress-bar-striped progress-bar-animated" style="width: @uploadProgress%">@uploadStatus (@uploadProgress%)</div></div> }
                <div class="mt-3"><button class="btn btn-primary" disabled="@(isUploading || selectedFile == null)" @onclick="Upload">Upload</button> <button class="btn btn-link" @onclick="ToggleUpload">Cancel</button></div>
            </div>
        </div>
    }

    @if (shareDocumentId.HasValue)
    {
        <div class="alert alert-light border d-flex align-items-center gap-2">
            <label class="form-label mb-0" for="share-type">Share with</label>
            <select id="share-type" class="form-select" @bind="shareType"><option value="user">User</option><option value="department">Department</option></select>
            @if (shareType == "department")
            {
                <select class="form-select" @bind="shareDepartment"><option value="">Choose a department</option>@foreach (var department in users.Select(u => u.Department).Where(d => !string.IsNullOrWhiteSpace(d)).Distinct().OrderBy(d => d)) { <option value="@department">@department</option> }</select>
            }
            else
            {
                <select id="share-user" class="form-select" @bind="shareUserId"><option value="">Choose a user</option>@foreach (var user in users.Where(u => u.UserId != currentUserId)) { <option value="@user.UserId">@user.DisplayName</option> }</select>
            }
            <button class="btn btn-primary" @onclick="Share">Share</button>
            <button class="btn btn-link" @onclick="ClearShare">Cancel</button>
        </div>
    }

    <div class="card">
        <div class="card-header"><div class="row g-2"><div class="col-md-4"><input class="form-control" placeholder="Search documents" @bind="searchText" @bind:event="oninput" /></div><div class="col-md-2"><select class="form-select" @bind="filterCategory"><option value="">All categories</option>@foreach (var item in DocumentValidation.Categories) { <option value="@item">@item</option> }</select></div><div class="col-md-2"><select class="form-select" @bind="sortBy"><option value="date">Recent</option><option value="title">Title</option><option value="category">Category</option><option value="size">Size</option></select></div><div class="col-md-2"><button class="btn btn-outline-secondary w-100" @onclick="ToggleShared">@(sharedOnly ? "All documents" : "Shared with me")</button></div><div class="col-md-2"><button class="btn btn-outline-secondary w-100" @onclick="LoadDocuments">Apply</button></div></div></div>
        <div class="card-body p-0">
            @if (documents == null) { <p class="p-4 text-muted">Loading documents...</p> }
            else if (!documents.Any()) { <p class="p-4 text-muted">No documents found.</p> }
            else { <div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Title</th><th>Category</th><th>Uploaded</th><th>Size</th><th>Project</th><th>Actions</th></tr></thead><tbody>@foreach (var document in documents) { <tr><td>@if (editingDocumentId == document.DocumentId) { <input class="form-control form-control-sm" @bind="editingTitle" /> } else { <strong>@document.Title</strong> }<br /><small class="text-muted">@document.OriginalFileName</small></td><td>@document.Category</td><td>@document.UploadedDate.ToLocalTime().ToString("MMM dd, yyyy")<br /><small class="text-muted">@document.UploaderName</small></td><td>@FormatSize(document.FileSize)</td><td>@(document.ProjectName ?? "Personal")</td><td><a class="btn btn-sm btn-outline-primary me-1" title="Download" href="/documents/@document.DocumentId/content?download=true"><i class="bi bi-download"></i></a>@if (document.FileType is "application/pdf" or "image/jpeg" or "image/png") { <a class="btn btn-sm btn-outline-secondary me-1" title="Preview" target="_blank" href="/documents/@document.DocumentId/content"><i class="bi bi-eye"></i></a> }<button class="btn btn-sm btn-outline-secondary me-1" title="Edit metadata" @onclick="() => BeginEdit(document)"><i class="bi bi-pencil"></i></button><button class="btn btn-sm btn-outline-secondary me-1" title="Replace file" @onclick="() => BeginReplace(document.DocumentId)"><i class="bi bi-arrow-repeat"></i></button><button class="btn btn-sm btn-outline-secondary me-1" title="Share" @onclick="() => BeginShare(document.DocumentId)"><i class="bi bi-share"></i></button><button class="btn btn-sm btn-outline-danger" title="Delete" @onclick="() => Delete(document.DocumentId)"><i class="bi bi-trash"></i></button>@if (editingDocumentId == document.DocumentId) { <button class="btn btn-sm btn-success ms-1" title="Save metadata" @onclick="() => SaveEdit(document)"><i class="bi bi-check"></i></button> }@if (replaceDocumentId == document.DocumentId) { <InputFile class="d-inline-block mt-1" @key="replaceInputKey" OnChange="ReplaceFile" /> }</td></tr> }</tbody></table></div> }
        </div>
    </div>
</div>

@code {
    private int currentUserId;
    private bool showUpload;
    private bool isUploading;
    private int uploadProgress;
    private string uploadStatus = string.Empty;
    private bool isError;
    private bool sharedOnly;
    private string? message;
    private string title = string.Empty;
    private string? description;
    private string category = string.Empty;
    private string? tags;
    private string searchText = string.Empty;
    private string filterCategory = string.Empty;
    private string sortBy = "date";
    private int? projectId;
    private int? taskId;
    private int inputKey;
    private int? editingDocumentId;
    private int? pendingDeleteId;
    private int? replaceDocumentId;
    private int replaceInputKey;
    private int? shareDocumentId;
    private int? shareUserId;
    private string shareType = "user";
    private string? shareDepartment;
    private string editingTitle = string.Empty;
    private IBrowserFile? selectedFile;
    private List<DocumentSummary>? documents;
    private List<Project> projects = new();
    private List<User> users = new();

    private IEnumerable<TaskItem> AvailableTasks => projectId.HasValue ? projects.Where(p => p.ProjectId == projectId).SelectMany(p => p.Tasks) : Enumerable.Empty<TaskItem>();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        int.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out currentUserId);
        if (currentUserId > 0)
        {
            projects = await ProjectService.GetUserProjectsAsync(currentUserId);
            users = await UserService.GetAllUsersAsync();
            await LoadDocuments();
        }
    }

    private async Task LoadDocuments()
    {
        documents = await DocumentService.SearchAsync(currentUserId, new DocumentSearchRequest { SearchText = searchText, Category = filterCategory, SortBy = sortBy, SharedWithMeOnly = sharedOnly });
    }

    private void ToggleUpload() => showUpload = !showUpload;
    private void ToggleShared() { sharedOnly = !sharedOnly; _ = LoadDocuments(); }
    private void BeginShare(int documentId) { shareDocumentId = documentId; shareUserId = null; shareDepartment = null; shareType = "user"; }
    private void ClearShare() { shareDocumentId = null; shareUserId = null; shareDepartment = null; }
    private void TaskChanged() { if (taskId.HasValue) projectId = null; }
    private async Task Share()
    {
        if (!shareDocumentId.HasValue || (shareType == "user" && !shareUserId.HasValue) || (shareType == "department" && string.IsNullOrWhiteSpace(shareDepartment))) { ShowError("Choose a recipient."); return; }
        var result = await DocumentService.ShareAsync(shareDocumentId.Value, currentUserId, shareType == "user" ? shareUserId : null, shareType == "department" ? shareDepartment : null);
        if (!result.Success) ShowError(result.Error ?? "The document could not be shared."); else { message = "Document shared."; isError = false; ClearShare(); }
    }
    private void SelectFile(InputFileChangeEventArgs args) => selectedFile = args.File;
    private void BeginReplace(int documentId) { replaceDocumentId = documentId; replaceInputKey++; }
    private async Task ReplaceFile(InputFileChangeEventArgs args)
    {
        if (!replaceDocumentId.HasValue) return;
        var file = args.File;
        try
        {
            await using var source = file.OpenReadStream(DocumentValidation.MaxFileSizeBytes);
            using var content = new MemoryStream();
            await source.CopyToAsync(content);
            content.Position = 0;
            var result = await DocumentService.ReplaceAsync(replaceDocumentId.Value, currentUserId, new DocumentUploadRequest { Title = "Replacement", Category = "Other", FileName = file.Name, FileSize = file.Size, ContentType = file.ContentType, Content = content });
            if (!result.Success) ShowError(result.Error ?? "Replacement failed."); else { message = "Document replaced."; isError = false; await LoadDocuments(); }
        }
        catch (Exception) { ShowError("The replacement could not be uploaded. The existing document is unchanged."); }
        finally { replaceDocumentId = null; }
    }
    private void BeginEdit(DocumentSummary document) { editingDocumentId = document.DocumentId; editingTitle = document.Title; }
    private async Task SaveEdit(DocumentSummary document)
    {
        if (await DocumentService.UpdateMetadataAsync(document.DocumentId, currentUserId, editingTitle, document.Description, document.Category, document.Tags))
        { editingDocumentId = null; message = "Document updated."; isError = false; await LoadDocuments(); }
        else ShowError("You are not authorized to edit this document.");
    }
    private async Task Delete(int documentId)
    {
        if (pendingDeleteId != documentId)
        {
            pendingDeleteId = documentId;
            ShowError("Select delete again to confirm permanent deletion.");
            return;
        }
        if (!await DocumentService.DeleteAsync(documentId, currentUserId)) { ShowError("You are not authorized to delete this document."); return; }
        pendingDeleteId = null; message = "Document deleted."; isError = false; await LoadDocuments();
    }

    private async Task Upload()
    {
        if (selectedFile == null) return;
        isUploading = true; uploadProgress = 0; uploadStatus = "Reading"; message = null;
        try
        {
            var fileName = selectedFile.Name;
            var fileSize = selectedFile.Size;
            var contentType = selectedFile.ContentType;
            using var memoryStream = new MemoryStream();
            await using (var fileStream = selectedFile.OpenReadStream(DocumentValidation.MaxFileSizeBytes))
            {
                var buffer = new byte[64 * 1024];
                long totalRead = 0;
                int read;
                while ((read = await fileStream.ReadAsync(buffer)) > 0)
                {
                    await memoryStream.WriteAsync(buffer.AsMemory(0, read));
                    totalRead += read;
                    uploadProgress = (int)Math.Min(100, totalRead * 100 / Math.Max(1, fileSize));
                    await InvokeAsync(StateHasChanged);
                }
            }
            memoryStream.Position = 0;
            selectedFile = null;
            uploadStatus = "Scanning";
            uploadProgress = 100;
            await InvokeAsync(StateHasChanged);
            var result = await DocumentService.UploadAsync(currentUserId, new DocumentUploadRequest { Title = title, Description = description, Category = category, Tags = tags, ProjectId = projectId, TaskId = taskId, FileName = fileName, FileSize = fileSize, ContentType = contentType, Content = memoryStream });
            if (!result.Success) { ShowError(result.Error ?? "Upload failed."); return; }
            message = "Document uploaded successfully."; showUpload = false; title = string.Empty; description = null; category = string.Empty; tags = null; projectId = null; taskId = null; inputKey++; await LoadDocuments();
        }
        catch (IOException) { ShowError("The file could not be read. Check its size and try again."); }
        catch (Exception) { ShowError("The document could not be uploaded. Please try again."); }
        finally { isUploading = false; uploadStatus = string.Empty; uploadProgress = 0; }
    }

    private void ShowError(string text) { message = text; isError = true; }
    private static string FormatSize(long bytes) => bytes < 1024 * 1024 ? $"{bytes / 1024.0:0.#} KB" : $"{bytes / 1024.0 / 1024:0.##} MB";
}
